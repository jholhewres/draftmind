# Copy to .env (gitignored) and fill in. Never commit .env.

# API
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://draftmind:draftmind@127.0.0.1:55433/draftmind?sslmode=disable

# OpenRouter (vision, Jev decisions, writer, STT)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Jev decision model on the System One endpoint
DECISION_MODEL=typesafe/jev-1.13
DECISION_PROVIDER=typesafe

# Chosen by benchmark in the vision slice (S3); leave empty until then
VISION_MODEL=
WRITER_MODEL=
STT_MODEL=

# Optional: raises the OpenDota rate limit
OPENDOTA_API_KEY=
