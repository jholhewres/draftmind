# Copy to .env (gitignored) and fill in. Never commit .env.

# API
HTTP_ADDR=127.0.0.1:8080
# Where the web app is served: sign-in links and Steam return here. A
# localhost URL is development (plain HTTP cookies); anything else must be https.
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://draftmind:draftmind@127.0.0.1:55433/draftmind?sslmode=disable
# The web build (web/dist) served at / with the API, for production. Empty
# serves the API alone (development uses the Vite dev server).
WEB_DIR=
# Comma-separated reverse proxy addresses (e.g. 127.0.0.1 behind nginx):
# their X-Real-IP / X-Forwarded-For is the client for rate limits and logs.
# Empty trusts no header.
TRUSTED_PROXY=

# OpenRouter (vision, Jev decisions, writer, STT)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Jev decision model on the System One endpoint
DECISION_MODEL=typesafe/jev-1.13
DECISION_PROVIDER=typesafe

# Photo read (ADR-0006). PHOTO_READER is the default reader, jev or vision,
# chosen by make bench-photo; the other one is its fallback.
PHOTO_READER=jev
# Jev for photos: Box questions need Jev 1.14
PHOTO_JEV_MODEL=typesafe/jev-1.14
# Fast, cheap vision model on OpenRouter with JSON-schema output
VISION_MODEL=google/gemini-3.1-flash-lite
# Local data outside git (the hero portrait cache)
DATA_DIR=data

# Writes the short draft tips: a fast, cheap text model on OpenRouter
WRITER_MODEL=openai/gpt-6-luna
# Transcribes push-to-talk clips (ADR-0005): a cheap audio-input model on OpenRouter
STT_MODEL=google/gemini-3.1-flash-lite

# Optional: raises the OpenDota rate limit
OPENDOTA_API_KEY=

# dotaconstants branch, tag or commit to sync from; each run records the commit it resolves to
DOTACONSTANTS_REF=master
# on: serve looks for a new patch every hour, syncs it from every source and
# makes it current only when all succeeded, and refreshes stats daily.
SYNC_SCHEDULE=off
# Live coach during a shared match (ADR-0014): off until the in-match benchmark runs.
# LIVE_WRITER=on lets the writer word live events; off, code templates do (no LLM call).
LIVE_COACH=off
LIVE_WRITER=off

# Sign-in links by e-mail (ADR-0008), STARTTLS when the server offers it.
# Without SMTP_HOST, development writes the link to the log; production
# turns e-mail sign-in off.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
